# ---------------------------------------------------------------------------
# Route A — recommended. No Google Cloud project, no OAuth consent screen.
# ---------------------------------------------------------------------------

# Gmail over IMAP. Turn on 2-Step Verification, then create an app password:
# https://myaccount.google.com/apppasswords
IMAP_USER=you@gmail.com
IMAP_PASSWORD=

# Service account for Sheets/Drive. Create one in the Google Cloud console
# (no OAuth consent screen needed), download the JSON key, then SHARE YOUR
# SHEET with the service account's client_email as an Editor.
# Accepts the JSON itself or a path to the file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Route B — only if you need the Gmail API (label writes, server-side search).
# Costs a Cloud project and a click through the unverified-app screen.
# Mint with: python scripts/google_oauth.py
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Extraction + destination
# ---------------------------------------------------------------------------

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# From the Sheets URL: docs.google.com/spreadsheets/d/<THIS>/edit
INVOICE_SHEET_ID=
